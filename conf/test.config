/*
 * Test profile — runs the full pipeline on generated fixtures.
 *
 * BUILD_PLAN §2.7 requires a `-profile test` that runs with no external data.
 * `params.input` stays null, so main.nf generates fixtures as its first
 * process and a cold clone completes end to end.
 */

params {
    config = "${projectDir}/config/test.yaml"
    input  = null
    outdir = 'results'
}

process {
    cpus   = 1
    memory = 1.GB
    time   = 10.m
}
