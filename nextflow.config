/*
 * morphline Nextflow configuration.
 */

manifest {
    name            = 'morphline'
    author          = 'Matt Glittenberg'
    description     = 'BIDS-aware longitudinal neuroimaging derivatives pipeline'
    mainScript      = 'main.nf'
    version         = '0.1.0'
    nextflowVersion = '>=23.10.0'
}

params {
    config  = "${projectDir}/config/test.yaml"
    input   = null
    outdir  = 'results'
    help    = false
}

// CI overrides this with the SHA-tagged image it just built, so the run always
// exercises the image under test rather than whatever `latest` happens to be.
process {
    container = 'ghcr.io/mattglittenberg/morphline:0.1.0'

    cpus   = 1
    memory = 2.GB
    time   = 30.m

    // Retry once on the exit codes that indicate a transient resource problem;
    // anything else is a real failure and should surface immediately.
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 143, 247] ? 'retry' : 'terminate' }
    maxRetries    = 1

    publishDir = [
        path: { "${params.outdir}" },
        mode: 'copy',
        overwrite: true,
    ]
}

profiles {
    test {
        includeConfig 'conf/test.config'
    }

    docker {
        docker.enabled       = true
        docker.runOptions    = '-u $(id -u):$(id -g)'
        apptainer.enabled    = false
        singularity.enabled  = false
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        docker.enabled       = false
    }

    // No container at all: run against a local editable install. This is the
    // path a developer without Docker uses.
    local {
        process.container = null
        docker.enabled    = false
        apptainer.enabled = false
    }
}

// Committed into docs/ from a real run — §2.7 calls the DAG image the cheapest
// high-impact thing in the project.
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt";     overwrite = true }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.html";      overwrite = true }
